<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <group android:name="pause_group" android:translateX="12" android:translateY="12">
                <path
                    android:name="p1"
                    android:fillColor="#FFFFFF"
                    android:pathData="M -6,-7 L -2, -7 L -2, 7 L -6, 7 Z" />
                <path
                    android:name="p2"
                    android:fillColor="#FFFFFF"
                    android:pathData="M 2,-7 L 6, -7 L 6, 7 L 2, 7 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="p1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:propertyName="pathData"
                android:valueFrom="M -6,-7 L -2, -7 L -2, 7 L -6, 7 Z"
                android:valueTo="M -4,-7 L 1, -3.5 L 1, 3.5 L -4, 7 Z"
                android:valueType="pathType" />
        </aapt:attr>
    </target>
    <target android:name="p2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="300"
                android:propertyName="pathData"
                android:valueFrom="M 2,-7 L 6, -7 L 6, 7 L 2, 7 Z"
                android:valueTo="M 1,-3.5 L 7, 0 L 7, 0 L 1, 3.5 Z"
                android:valueType="pathType" />
        </aapt:attr>
    </target>
</animated-vector>